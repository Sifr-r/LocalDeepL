            "type": "array"
          }
        },
        "title": "HTTPValidationError",
        "type": "object"
      },
      "JobListItemResponse": {
        "description": "Mirrors the frontend ``JobRecordResponse`` contract.",
        "properties": {
          "duration_s": {
            "default": 0.0,
            "title": "Duration S",
            "type": "number"
          },
          "failed_pages": {
            "items": {
              "type": "integer"
            },
            "title": "Failed Pages",
            "type": "array"
          },
          "filename": {
            "default": "",
            "title": "Filename",
            "type": "string"
          },
          "id": {
            "title": "Id",
            "type": "string"
          },
          "model": {
            "default": "",
            "title": "Model",
            "type": "string"
          },
          "pages": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Pages"
          },
          "pipeline_mode": {
            "default": "",
            "title": "Pipeline Mode",
            "type": "string"
          },
          "status": {
            "title": "Status",
            "type": "string"
          },
          "timestamp": {
            "default": "",
            "title": "Timestamp",
            "type": "string"
          }
        },
        "required": [
          "id",
          "status"
        ],
        "title": "JobListItemResponse",
        "type": "object"
      },
      "JobStatusResponse": {
        "description": "Mirrors the frontend ``OcrJobStatusResponse`` contract.",
        "properties": {
          "completed_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Completed At"
          },
          "created_at": {
            "title": "Created At",
            "type": "number"
          },
          "duration_s": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],
            "title": "Duration S"
          },
          "error": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Error"
          },
          "failed_pages": {
            "items": {
              "type": "integer"
            },
            "title": "Failed Pages",
            "type": "array"
          },
          "filename": {
            "default": "",
            "title": "Filename",
            "type": "string"
          },
          "job_id": {
            "title": "Job Id",
            "type": "string"
          },
          "started_at": {
            "anyOf": [
              {
                "type": "number"
              },
              {
                "type": "null"
              }
            ],

          "apiBase": {
            "title": "Apibase",
            "type": "string"
          },
          "apiKey": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Apikey"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "providerId": {
            "title": "Providerid",
            "type": "string"
          }
        },
        "required": [
          "providerId",
          "apiBase",
          "model"
        ],
        "title": "SetActiveProviderRequest",
        "type": "object"
      },
      "SetActiveProviderResponse": {
        "description": "Ack for ``POST /api/providers/active`` \u2014 echoes the persisted state.",
        "properties": {
          "api_base": {
            "title": "Api Base",
            "type": "string"
          },
          "model": {
            "title": "Model",
            "type": "string"
          },
          "provider_id": {
            "title": "Provider Id",
            "type": "string"
          },
          "status": {
            "const": "ok",
            "title": "Status",
            "type": "string"
          }
        },
        "required": [
          "status",
          "provider_id",
          "api_base",
          "model"
        ],
        "title": "SetActiveProviderResponse",
        "type": "object"
      },
      "ValidationError": {
        "properties": {
          "ctx": {
            "title": "Context",
            "type": "object"
          },
          "input": {
            "title": "Input"
          },
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "title": "Location",
            "type": "array"
          },
          "msg": {
            "title": "Message",
            "type": "string"
          },
          "type": {
            "title": "Error Type",
            "type": "string"
          }
        },
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError",
        "type": "object"
      },
      "_SessionRequest": {
        "properties": {

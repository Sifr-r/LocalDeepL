# ===========================================================================
# OmniScribe — Environment Configuration Template
#
#   cp .env.example .env
#
# AGENTS.md is the authoritative reference for all settings. This file
# documents every environment variable the application reads, with safe
# local-development defaults. See AGENTS.md "Web Notes" for details.
# ===========================================================================

# ── LLM / VLM Endpoint ──────────────────────────────────────────────────────
# OpenAI-compatible VLM endpoint. Default targets LM Studio on localhost.
# For Docker, use http://host.docker.internal:1234/v1 to reach a host-side
# LM Studio. For Ollama, use http://localhost:11434/v1.
LLM_API_BASE=http://localhost:1234/v1

# API key for the VLM endpoint. LM Studio accepts any non-empty string.
LLM_API_KEY=lm-studio

# Model identifier loaded on the VLM server. Must match a model returned by
# GET /v1/models — the server pre-flights this before each /api/process call
# to guard against LM Studio's silent model fallback (issue #7).
LLM_MODEL=allenai/olmocr-2-7b

# ── Security ─────────────────────────────────────────────────────────────────
# Set to require `Authorization: Bearer <token>` on every HTTP route.
# Uses constant-time comparison (secrets.compare_digest). Unset = open
# (local-desktop default). Generate a strong secret, e.g.:
#   python -c "import secrets; print(secrets.token_urlsafe(32))"
# OMNISCRIBE_AUTH_TOKEN=change-me-to-a-strong-secret

# Comma-separated CORS allowlist for cross-origin browser requests.
# Empty/unset = same-origin only.
# OMNISCRIBE_CORS_ORIGINS=http://localhost:3000,http://localhost:8080

# Max request body size in megabytes. Default 10240 (10 GB), hard-capped at
# 102400 (100 GB). The 10 GB default keeps the file picker from silently
# hiding the option to ingest very large image/PDF collections.
OMNISCRIBE_MAX_UPLOAD_MB=10240

# Number of pages per chunk when streaming long OCR jobs. Default 25.
# Smaller chunks = finer-grained progress; larger chunks = fewer round-trips.
# OMNISCRIBE_CHUNK_PAGES=25

# Per-client-IP HTTP request cap (sliding 60s window). Unset or 0 = disabled.
# OMNISCRIBE_RATE_LIMIT_PER_MIN=60

# Allow the server to connect to local/private IP addresses (LM Studio,
# Ollama, etc.). true is the local-development default; set to false when
# exposing the server to untrusted users.
ALLOW_SSRF_LOCAL=true

# ── VLM Resilience (retry + circuit breaker) ────────────────────────────────
# Every LLM call retries transient errors (429/5xx/connection resets) with
# exponential backoff. A per-request circuit breaker fails fast once the
# endpoint is deemed down so remaining pages don't each burn a full timeout.

# Max retry attempts for transient LLM errors (429, 5xx, connection resets).
OMNISCRIBE_LLM_MAX_RETRIES=2

# Base delay (seconds) for exponential backoff. Actual delay is
# min(base * 2^attempt, 8.0).
OMNISCRIBE_LLM_RETRY_BASE_DELAY=1.0

# Consecutive failures before the circuit breaker opens (fails fast with
# CircuitOpenError until the cooldown expires).
OMNISCRIBE_CB_FAILURE_THRESHOLD=5

# Seconds the circuit stays open before a half-open probe is allowed through.
OMNISCRIBE_CB_COOLDOWN=30

# ── OCR Pipeline ─────────────────────────────────────────────────────────────
# Number of pages processed concurrently.
OCR_CONCURRENCY=3

# DPI for PDF-to-image rasterization.
OCR_DPI=200

# Dense page handling: "auto" switches to per-box OCR when box count exceeds
# the dense threshold. Other values: "always", "never".
OCR_DENSE_MODE=auto

# Box count that triggers dense mode when OCR_DENSE_MODE=auto.
OCR_DENSE_THRESHOLD=60

# Maximum image dimension (pixels) for VLM input.
OCR_MAX_IMAGE_DIM=1024

# Re-align sparse OCR text to detection boxes using Dynamic Programming.
OCR_REFINE=true

# Pre-flight: verify the model is loaded on the VLM server before processing.
OCR_VERIFY_MODEL=true

# Pipeline mode: "hybrid" (Surya detect -> VLM OCR -> DP align -> refine)
# or "grounded" (single bbox-native VLM call, skips Surya and alignment).
OCR_PIPELINE_MODE=hybrid

# Self-correction: re-prompt the VLM on low-confidence pages.
OCR_SELF_CORRECTION=false

# Binarize images before OCR (useful for scanned documents).
OCR_BINARIZE=false

# Run both hybrid and grounded engines, then merge results.
OCR_DUAL_ENGINE=false

# Dictionary spellcheck post-processing: "none", "auto", or a language code.
OCR_SPELLCHECK=none

# Cross-page text alignment for multi-page documents.
OCR_CROSS_PAGE=false

# ── Page Preprocessing (hybrid path) ────────────────────────────────────────
# Master switch for the page preprocessor. Individual steps are toggled below.
OCR_PREPROCESS_PAGES=false

# Detect and correct page orientation.
OCR_ORIENTATION_DETECTION=false

# Deskew (straighten) pages.
OCR_DESKEW=false

# Denoise images.
OCR_DENOISE=false

# Normalize contrast.
OCR_NORMALIZE_CONTRAST=false

# Crop page margins / cleanup.
OCR_CROP_CLEANUP=false

# Route pages to different OCR strategies based on quality analysis.
OCR_QUALITY_ROUTING=false

# ── Async Translation (Celery + Redis + LangGraph) ──────────────────────────
# Requires the "async-translation" extra (Celery + Redis + LangGraph).
# Browser translation uses synchronous endpoints and does NOT need Redis.

# Redis URL for Celery broker and result backend.
REDIS_URL=redis://localhost:6379/0

# Override the ChromaDB directory for the lexicon-backed RAG feature.
# Requires the separate "memory" extra (ChromaDB + sentence-transformers).
# Unset = default path next to the package root (chroma_db/).
# OMNISCRIBE_CHROMA_DB=/path/to/chroma_db
